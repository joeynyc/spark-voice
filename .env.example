# Spark Voice settings for docker compose. scripts/setup.sh copies this to .env and fills the secret.
#
# One Spark: leave the addresses as they are.
# Two Sparks: see docs/two-sparks.md (in short: SPARK2 and the model hosts point at Spark 2).

SPARK1=127.0.0.1
SPARK2=

# Where each model runs. With two Sparks, set the hosts to Spark 2's address and the nodes to "Spark 2".
LLM_HOST=127.0.0.1
LLM_NODE=Spark 1
TTS_HOST=127.0.0.1
TTS_NODE=Spark 1
ASR_HOST=127.0.0.1
SEARCH_HOST=127.0.0.1

# Who can reach what. The app is on your network (APP_BIND); the model servers and stats agent only listen
# on BIND. One Spark: leave BIND=127.0.0.1. Two Sparks: on Spark 2, set BIND to its QSFP/LAN address.
APP_BIND=0.0.0.0
BIND=127.0.0.1
# Optional password for the app. If set, open it once as http://<spark>:7799/?token=<this>; a cookie remembers you.
APP_TOKEN=

# Ports
APP_PORT=7799
TTS_PORT=7798
ASR_PORT=7797
STATS_PORT=7796
SEARCH_PORT=7795
LLM_PORT=8000

# Share of the Spark's memory for the chat model (0.30 is about 36 GB).
LLM_GPU_SHARE=0.30

# Only needed for a cloud or keyed chat model.
LLM_API_KEY=
# Optional: a Hugging Face token for faster downloads.
HF_TOKEN=

SEARXNG_SECRET=
